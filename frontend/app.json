{
  "expo": {
    "name": "GETINSURE CRM",
    "slug": "getinsure-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "getinsure",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getinsure.crm",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos for lead interactions",
        "NSPhotoLibraryUsageDescription": "Share images via WhatsApp",
        "NSLocationWhenInUseUsageDescription": "Tag location for meetings",
        "NSMicrophoneUsageDescription": "Voice input for AI assistant"
      }
    },
    "android": {
      "package": "com.getinsure.crm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#009688"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#009688"
        }
      ],
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GETINSURE CRM to access your photos for sharing via WhatsApp",
          "cameraPermission": "Allow GETINSURE CRM to take photos for lead interactions"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "getinsure-crm"
      }
    }
  }
}
