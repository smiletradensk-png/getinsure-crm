{
  "expo": {
    "name": "GETINSURE CRM",
    "slug": "getinsure-crm",
    "version": "1.1.0",
    "description": "Premium CRM for insurance agents. Manage leads, follow-ups, and pipeline entirely offline with no subscription fees.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "getinsure",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getinsure.crm",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos for lead interactions",
        "NSPhotoLibraryUsageDescription": "Share images via WhatsApp",
        "NSLocationWhenInUseUsageDescription": "Tag location for meetings",
        "NSMicrophoneUsageDescription": "Voice input for AI assistant"
      }
    },
    "android": {
      "package": "com.getinsure.crm",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A237E"
      },
      "edgeToEdgeEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#1A237E"
        }
      ],
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GETINSURE CRM to access your photos for sharing via WhatsApp",
          "cameraPermission": "Allow GETINSURE CRM to take photos for lead interactions"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#009688",
          "defaultChannel": "default"
        }
      ],
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow GETINSURE CRM to access your contacts to import them as leads"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8113e3a-ded7-4630-8c71-e44bf0727450"
      }
    },
    "owner": "gitessh"
  }
}
