# ── Facebook App Settings ───────────────────────────────────────────────────
# Get these from developers.facebook.com → Your App → Settings / Lead Ads

# App Secret (Settings → Basic)
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Page Access Token (from Graph API Explorer or your app's token)
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Your custom verify token — type any string, then paste it into Facebook webhook settings
VERIFY_TOKEN=getinsure_fb_webhook

# ── App Security ────────────────────────────────────────────────────────────
# Secret key the mobile app must send in x-app-key header to fetch leads
# Change this to any random string and enter the same in the app Settings → Facebook Live Leads
APP_ACCESS_KEY=getinsure-crm-key-change-this-to-something-random

# ── Firebase (optional but recommended) ────────────────────────────────────
# Without Firebase, leads are stored in memory and lost when the server restarts.
# With Firebase, leads persist forever even after restarts.
#
# To set up:
#   1. Go to console.firebase.google.com → your project
#   2. Project Settings → Service Accounts → Generate new private key
#   3. Paste the ENTIRE JSON content below (as a single line)
#
FIREBASE_SERVICE_ACCOUNT_JSON=

# Port (Render.com sets this automatically)
PORT=3000
